# --- Server Configuration ---
PORT=1738
NODE_ENV=development
CORS_ORIGIN=*

# --- Neo4j Database (REQUIRED) ---
# Replace the URI, Username, and Password with the actual AuraDB or local credentials
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_database_password

# --- Internal Authentication (REQUIRED) ---
# A long, random string used to sign the JSON Web Tokens for the Flutter app
JWT_SECRET=generate_a_very_long_random_string_here
JWT_EXPIRES_IN=7d

# --- Social Login Providers ---
# Credentials from the Google Cloud Console and Meta Developer Portal
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# --- B2B Microservices Handshake ---
# The shared secret key that must exactly match the .env file in the Tourism and Transport backends
GATEWAY_INTERNAL_SECRET=

# The local or production URLs where the other microservices are running
TOURISM_SERVICE_URL=http://localhost:3001
TRANSPORT_SERVICE_URL=http://localhost:3002
SHU_SERVICE_URL=http://localhost:3003